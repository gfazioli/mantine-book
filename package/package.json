{
  "name": "@gfazioli/mantine-book",
  "version": "0.0.0",
  "private": true,
  "description": "Realistic iBooks-style page-curl component for React built with Mantine. Curl a single sheet with two faces (Front/Back) by dragging any point of its free edge in any direction — a pure-DOM reflection fold (flat) or a true 3D WebGL curl (rounded). The foundation for a future page-flip Book.",
  "homepage": "https://gfazioli.github.io/mantine-book/",
  "packageManager": "yarn@4.0.1",
  "license": "MIT",
  "author": "Giovambattista Fazioli <giovambattista.fazioli@gmail.com>",
  "keywords": [
    "3d",
    "book",
    "component",
    "curl",
    "ebook",
    "extension",
    "flip",
    "ibooks",
    "mantine",
    "mantine-ui",
    "mantine-v9",
    "page-curl",
    "page-flip",
    "page-turn",
    "paper",
    "react",
    "react-component",
    "typescript",
    "webgl"
  ],
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.mjs",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/index.d.mts",
        "default": "./dist/esm/index.mjs"
      },
      "require": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/cjs/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./styles.layer.css": "./dist/styles.layer.css"
  },
  "repository": "https://github.com/gfazioli/mantine-book.git",
  "dependencies": {
    "@zumer/snapdom": "^2.12.2"
  },
  "peerDependencies": {
    "@mantine/core": ">=9.0.0",
    "@mantine/hooks": ">=9.0.0",
    "react": "^18.x || ^19.x",
    "react-dom": "^18.x || ^19.x"
  },
  "bugs": "https://github.com/gfazioli/mantine-book/issues"
}
